{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maindscout.local/schemas/company_domain_claim.schema.json",
  "title": "CompanyDomainClaim payload",
  "description": "Industry domains the company works in (e.g. fintech, procurement, aerospace). One claim per company.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domains"
  ],
  "properties": {
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  }
}
