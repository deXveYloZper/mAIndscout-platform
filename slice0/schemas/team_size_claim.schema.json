{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maindscout.local/schemas/team_size_claim.schema.json",
  "title": "TeamSizeClaim payload",
  "description": "Headcount at a point in time. Volatile: a later value is growth, not a contradiction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "raw"
  ],
  "properties": {
    "min": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "raw": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD as found"
    }
  }
}
