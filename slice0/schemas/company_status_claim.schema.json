{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maindscout.local/schemas/company_status_claim.schema.json",
  "title": "CompanyStatusClaim payload",
  "description": "Active, acquired, merged, shut down or public, with the date when known.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acquired",
        "merged",
        "shut_down",
        "public"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD as found"
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
